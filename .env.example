# Solana RPC Configuration
# Required: Your Solana RPC endpoint URL
# Recommended: Use a dedicated RPC from Helius, Quicknode, or Triton
# Free tier: https://api.devnet.solana.com (rate limited)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Network: 'devnet' or 'mainnet-beta'
SOLANA_NETWORK=devnet

# Server port (optional, defaults to 3000)
PORT=3000
